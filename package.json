{
  "name": "aws-internal-tools",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter './apps/*' run dev",
    "dev:cw": "pnpm --filter cloudwatch-viewer dev",
    "dev:billing": "pnpm --filter billing-dashboard dev",
    "build": "pnpm -r run build",
    "build:cw": "pnpm --filter cloudwatch-viewer build",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.4"
}
